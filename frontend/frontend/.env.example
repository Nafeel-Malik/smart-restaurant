# Copy this file to .env for local Vite development:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# Backend API base URL (browser calls this). Required for local `npm run dev`.
VITE_API_URL=http://localhost:5001

# Docker Compose bakes VITE_API_URL at image build time via docker-compose.yml
# (http://localhost:5001). The browser talks to the host-mapped backend port,
# not the internal Docker service name.
