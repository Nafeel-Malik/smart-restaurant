# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
# Never commit backend/.env — it is gitignored.

# HTTP port for the NestJS API
PORT=5001

# Local MongoDB. Docker Compose overrides this to mongodb://mongodb:27017/smart_restaurant
MONGO_URI=mongodb://localhost:27017/smart_restaurant

# Long random string used to sign staff + customer JWTs (32+ characters)
JWT_SECRET=your_jwt_secret_here

# Exactly 64 hex characters (32 bytes). Encrypts SMTP App Passwords stored in MongoDB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=replace_with_64_character_hex_string

# Optional Gmail SMTP fallback if Superadmin has not saved Email Settings in the app.
# Use a Gmail App Password (16 characters, no spaces), not your regular Gmail password.
EMAIL_USER=your_gmail_here@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password_here

# Optional. Comma-separated browser origins for CORS.
# Defaults to http://localhost:5173 and http://localhost:4173 if unset.
# Docker Compose sets this automatically.
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional. Used only by `npm run seed` / one-click start seed step.
# SUPERADMIN_SEED_USERNAME=admin
# SUPERADMIN_SEED_PASSWORD=admin123
